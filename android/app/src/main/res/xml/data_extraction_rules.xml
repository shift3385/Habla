<?xml version="1.0" encoding="utf-8"?>
<!-- Copias en la nube y paso a otro teléfono (Android 12+): la clave de Gemini nunca sale del teléfono (D-02). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </device-transfer>
</data-extraction-rules>
