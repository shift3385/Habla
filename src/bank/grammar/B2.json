[
{"id":"gram_b2_0001","skill":"grammar","level":"B2","area":"grammar","point":"third conditional","topic":"travel","model":"Cambridge B2 First – multiple-choice cloze","format":"mc","prompt":"If we had left earlier, we ____ the train.","options":["wouldn't have missed","didn't miss","won't miss","hadn't missed"],"key":0,"traps":["pasado simple: no es la consecuencia hipotética","futuro: la situación ya pasó","'had' va en la parte del 'if', no en el resultado"]},
{"id":"gram_b2_0002","skill":"grammar","level":"B2","area":"grammar","point":"wish + past simple","topic":"home","model":"Cambridge B2 First – multiple-choice cloze","format":"mc","prompt":"I wish I ____ a bigger flat. This one is far too small.","options":["have","had","would have","will have"],"key":1,"traps":["tras 'wish' para el presente va pasado, no presente","'would have' se usa para hechos, no para deseos sobre uno mismo","futuro: no expresa un deseo irreal"]},
{"id":"gram_b2_0003","skill":"grammar","level":"B2","area":"grammar","point":"causative: have something done","topic":"cars","model":"Cambridge B2 First – multiple-choice cloze","format":"mc","prompt":"I'm going to ____ next week because the brakes make a strange noise.","options":["repair my car","have repaired my car","have my car repaired","make my car repair"],"key":2,"traps":["dice que lo reparas tú mismo","orden incorrecto: el objeto va antes del participio","'make' + infinitivo significa obligar a alguien"]},
{"id":"gram_b2_0004","skill":"grammar","level":"B2","area":"grammar","point":"past modal deduction: must have","topic":"daily life","model":"Cambridge B2 First – multiple-choice cloze","format":"mc","prompt":"The streets are wet. It ____ during the night.","options":["must rain","should have rained","can have rained","must have rained"],"key":3,"traps":["presente: la deducción es sobre el pasado","'should have' expresa lo que debería haber pasado","'can have' no se usa en afirmativa para deducir"]},
{"id":"gram_b2_0005","skill":"grammar","level":"B2","area":"grammar","point":"look forward to + -ing","topic":"work","model":"Cambridge B2 First – multiple-choice cloze","format":"mc","prompt":"I look forward to ____ from you soon.","options":["hearing","hear","heard","be hearing"],"key":0,"traps":["'to' es preposición aquí: va gerundio","participio, no gerundio","combinación incorrecta"]},
{"id":"gram_b2_0006","skill":"grammar","level":"B2","area":"grammar","point":"be used to + -ing","topic":"work","model":"Cambridge B2 First – multiple-choice cloze","format":"mc","prompt":"After two years in the night shift, I'm used to ____ during the day.","options":["sleep","sleeping","slept","have slept"],"key":1,"traps":["'be used to' va con gerundio: estar acostumbrado","participio, no gerundio","combinación incorrecta"]},
{"id":"gram_b2_0007","skill":"grammar","level":"B2","area":"grammar","point":"reported questions","topic":"job interview","model":"Cambridge B2 First – multiple-choice cloze","format":"mc","prompt":"The interviewer asked me why ____ to leave my previous job.","options":["did I decide","I decide","I had decided","had I decided"],"key":2,"traps":["en estilo indirecto no se invierte sujeto y auxiliar","falta el cambio de tiempo","orden de pregunta directa"]},
{"id":"gram_b2_0008","skill":"grammar","level":"B2","area":"grammar","point":"future perfect","topic":"studies","model":"Cambridge B2 First – multiple-choice cloze","format":"mc","prompt":"By the end of this year, I ____ my degree.","options":["will finish","am finishing","finish","will have finished"],"key":3,"traps":["con 'by + momento' se usa el futuro perfecto","presente continuo para planes, no para algo terminado antes de un momento","presente simple"]},
{"id":"gram_b2_0009","skill":"grammar","level":"B2","area":"grammar","point":"past perfect","topic":"travel","model":"Cambridge B2 First – multiple-choice cloze","format":"mc","prompt":"When we arrived at the station, the train ____.","options":["had already left","already left","has already left","was already leaving"],"key":0,"traps":["hace falta marcar que pasó antes de llegar","present perfect no encaja en una narración en pasado","continuo: el tren seguiría en la estación"]},
{"id":"gram_b2_0010","skill":"grammar","level":"B2","area":"grammar","point":"non-defining relative clauses","topic":"cities","model":"Cambridge B2 First – multiple-choice cloze","format":"mc","prompt":"Valencia, ____ is on the east coast of Spain, is famous for paella.","options":["that","which","where","what"],"key":1,"traps":["'that' no se usa entre comas (oración explicativa)","'where' necesitaría otro sujeto: 'where people...'","'what' no introduce relativas"]},
{"id":"gram_b2_0011","skill":"grammar","level":"B2","area":"grammar","point":"it's time + past simple","topic":"daily life","model":"Cambridge B2 First – multiple-choice cloze","format":"mc","prompt":"It's ten o'clock. It's time we ____ home.","options":["had gone","will go","went","are going"],"key":2,"traps":["pasado perfecto: la estructura pide pasado simple","futuro: no se usa en esta estructura","continuo: no se usa en esta estructura"]},
{"id":"gram_b2_0012","skill":"grammar","level":"B2","area":"grammar","point":"would rather + past","topic":"free time","model":"Cambridge B2 First – multiple-choice cloze","format":"mc","prompt":"I'd rather you ____ smoke in the house.","options":["don't","won't","not","didn't"],"key":3,"traps":["con otro sujeto, 'would rather' va con pasado","futuro: no se usa en esta estructura","falta el auxiliar"]},
